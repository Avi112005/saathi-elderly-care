# --- Database -------------------------------------------------------------
# SQLite file for local/single-node use. For PostgreSQL, change the provider in
# prisma/schema.prisma and use a postgres:// URL here.
DATABASE_URL="file:./saathi.db"

# --- App ------------------------------------------------------------------
# Public URL used in email links and for the same-origin check on mutations.
APP_URL="http://localhost:3000"

# --- Email (SMTP) ---------------------------------------------------------
# Leave SMTP_HOST empty to run without sending: every email is still written to
# the in-app Outbox (status LOGGED) so you can see exactly what would go out.
# Works with Gmail (app password), Resend, Brevo, Mailgun, SES, Mailtrap...
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Saathi Care <reminders@example.com>"

# --- Reminder engine ------------------------------------------------------
# "on": the Node server runs a sweep every minute (best for a long-running server).
# "off": rely on an external cron calling POST /api/cron/reminders instead.
REMINDER_SCHEDULER="on"
# Bearer token required by /api/cron/reminders. Generate: openssl rand -hex 32
CRON_SECRET=""

# --- Demo data (optional) -------------------------------------------------
# PINs for the seeded demo circle (CARE-2468). Leave empty and `npm run db:seed`
# generates random ones and prints them once. Never commit real values.
DEMO_ELDER_PIN=""
DEMO_CARETAKER_PIN=""
DEMO_FAMILY_PIN=""
