// Saathi data model.
// SQLite is used for local development and single-node deployments. To move to
// PostgreSQL, change `provider` below to "postgresql" and point DATABASE_URL at it.
// Enumerated values are stored as strings and validated in `src/lib/domain/types.ts`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One elderly person's healthcare profile — the centre of a care circle.
model CareProfile {
  id               String    @id @default(cuid())
  careCode         String    @unique
  fullName         String
  preferredName    String
  dateOfBirth      DateTime?
  timezone         String    @default("Asia/Kolkata")
  conditions       String    @default("")
  allergies        String    @default("")
  bloodGroup       String?
  emergencyContact String?
  primaryDoctor    String?
  notes            String    @default("")
  /// When true, medication changes by anyone other than the elder need the elder's approval.
  consentMode      Boolean   @default(true)
  /// Minutes before a dose that the "upcoming dose" email is sent.
  reminderLeadMin  Int       @default(15)
  /// Minutes after a dose before the elder and caretakers are nudged.
  nudgeAfterMin    Int       @default(30)
  /// Minutes after a dose before it is marked missed and the whole circle is told.
  escalateAfterMin Int       @default(120)
  isDemo           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  members        Member[]
  invites        Invite[]
  medications    Medication[]
  doseLogs       DoseLog[]
  appointments   Appointment[]
  changeRequests ChangeRequest[]
  notifications  Notification[]
  activity       ActivityLog[]
  routines       Routine[]
  routineLogs    RoutineLog[]
}

/// A person with access to a care profile (the elder, a caretaker or family).
model Member {
  id                 String    @id @default(cuid())
  profileId          String
  name               String
  email              String?
  relationship       String    @default("")
  /// ELDER | CARETAKER | FAMILY
  role               String
  isAdmin            Boolean   @default(false)
  passcodeHash       String
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  avatarColor        String    @default("sky")
  emailDoseReminders Boolean   @default(true)
  emailMissedDoses   Boolean   @default(true)
  emailAppointments  Boolean   @default(true)
  emailRefills       Boolean   @default(true)
  emailDailyDigest   Boolean   @default(false)
  /// Out-of-range health readings (blood pressure, sugar, pulse).
  emailVitalAlerts   Boolean   @default(true)
  /// "HH:MM" local times; reminders that can wait are held during quiet hours.
  quietStart         String?
  quietEnd           String?
  active             Boolean   @default(true)
  lastSeenAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile        CareProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sessions       Session[]
  doseLogs       DoseLog[]
  routineLogs    RoutineLog[]
  requested      ChangeRequest[] @relation("RequestedBy")
  decided        ChangeRequest[] @relation("DecidedBy")
  activity       ActivityLog[]
  invitesCreated Invite[]        @relation("InviteCreatedBy")

  @@index([profileId])
}

/// A one-time, expiring code that lets a new person join a care circle.
model Invite {
  id          String    @id @default(cuid())
  profileId   String
  codeHash    String    @unique
  role        String
  label       String    @default("")
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  profile   CareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdBy Member      @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 of the session token; the raw token only ever lives in the cookie.
  tokenHash String   @unique
  memberId  String
  expiresAt DateTime
  userAgent String   @default("")
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model Medication {
  id             String    @id @default(cuid())
  profileId      String
  name           String
  strength       String    @default("")
  /// TABLET | CAPSULE | LIQUID | INJECTION | INHALER | DROPS | PATCH | OTHER
  form           String    @default("TABLET")
  doseQuantity   Float     @default(1)
  doseUnit       String    @default("tablet")
  /// Comma-separated local "HH:MM" times, e.g. "08:00,20:00".
  times          String
  /// Comma-separated ISO weekdays (1 = Monday … 7 = Sunday).
  daysOfWeek     String    @default("1,2,3,4,5,6,7")
  startDate      String
  endDate        String?
  /// BEFORE_FOOD | WITH_FOOD | AFTER_FOOD | EMPTY_STOMACH | ANY
  foodTiming     String    @default("ANY")
  instructions   String    @default("")
  purpose        String    @default("")
  prescriber     String    @default("")
  appearance     String    @default("")
  pillColor      String    @default("white")
  /// Units on hand (tablets, ml…). Null when the family does not track stock.
  stockCount     Float?
  /// Days of supply left at which a refill reminder is sent.
  refillAt       Float     @default(7)
  active         Boolean   @default(true)
  /// When the times/days last changed. Doses before this follow the old schedule, so
  /// only logged doses are counted for that period (no phantom "missed" doses).
  scheduleChangedAt DateTime @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  profile        CareProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  doseLogs       DoseLog[]
  changeRequests ChangeRequest[]

  @@index([profileId, active])
}

/// The outcome of one scheduled dose. Doses with no row are pending.
model DoseLog {
  id           String    @id @default(cuid())
  profileId    String
  medicationId String
  scheduledFor DateTime
  /// TAKEN | SKIPPED | MISSED
  status       String
  actedAt      DateTime  @default(now())
  /// Null when the reminder engine marked the dose missed.
  loggedById   String?
  note         String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile    CareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  medication Medication  @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  loggedBy   Member?     @relation(fields: [loggedById], references: [id], onDelete: SetNull)

  @@unique([medicationId, scheduledFor])
  @@index([profileId, scheduledFor])
}

/// A recurring healthcare routine that isn't a medicine: a blood-pressure check, a sugar
/// test, a walk, physiotherapy. Measurement routines record a reading each time.
model Routine {
  id                String   @id @default(cuid())
  profileId         String
  title             String
  /// ACTIVITY | BLOOD_PRESSURE | BLOOD_SUGAR | PULSE | WEIGHT
  kind              String   @default("ACTIVITY")
  /// Comma-separated local "HH:MM" times.
  times             String
  daysOfWeek        String   @default("1,2,3,4,5,6,7")
  startDate         String
  endDate           String?
  notes             String   @default("")
  active            Boolean  @default(true)
  scheduleChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile CareProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  logs    RoutineLog[]

  @@index([profileId, active])
}

/// One completed (or skipped) routine, with the reading for measurement routines.
model RoutineLog {
  id           String   @id @default(cuid())
  profileId    String
  routineId    String
  scheduledFor DateTime
  /// DONE | SKIPPED
  status       String
  systolic     Int?
  diastolic    Int?
  /// Blood sugar (mg/dL), pulse (bpm) or weight (kg).
  value        Float?
  /// NORMAL | LOW | HIGH | URGENT — computed from the reading.
  flag         String   @default("NORMAL")
  note         String   @default("")
  loggedById   String?
  actedAt      DateTime @default(now())
  createdAt    DateTime @default(now())

  profile  CareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  routine  Routine     @relation(fields: [routineId], references: [id], onDelete: Cascade)
  loggedBy Member?     @relation(fields: [loggedById], references: [id], onDelete: SetNull)

  @@unique([routineId, scheduledFor])
  @@index([profileId, scheduledFor])
}

model Appointment {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  doctorName  String   @default("")
  specialty   String   @default("")
  location    String   @default("")
  startsAt    DateTime
  durationMin Int      @default(30)
  notes       String   @default("")
  /// Newline-separated questions the elder wants to ask.
  questions   String   @default("")
  /// SCHEDULED | COMPLETED | CANCELLED
  status      String   @default("SCHEDULED")
  outcome     String   @default("")
  transport   String   @default("")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile CareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, startsAt])
}

/// A medication change proposed by someone other than the elder, awaiting the elder's decision.
model ChangeRequest {
  id            String    @id @default(cuid())
  profileId     String
  /// CREATE | UPDATE | ARCHIVE
  kind          String
  medicationId  String?
  /// JSON of the validated medication input.
  payload       String
  summary       String
  /// PENDING | APPROVED | DECLINED
  status        String    @default("PENDING")
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  profile     CareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  medication  Medication? @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  requestedBy Member      @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  decidedBy   Member?     @relation("DecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([profileId, status])
}

/// Email outbox. `dedupeKey` makes every reminder idempotent across scheduler runs.
model Notification {
  id        String    @id @default(cuid())
  profileId String
  memberId  String?
  toEmail   String
  kind      String
  subject   String
  bodyText  String
  bodyHtml  String
  dedupeKey String    @unique
  /// QUEUED | SENT | LOGGED | FAILED
  status    String    @default("QUEUED")
  error     String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  profile CareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  profileId String
  actorId   String?
  action    String
  summary   String
  createdAt DateTime @default(now())

  profile CareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  actor   Member?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
}
