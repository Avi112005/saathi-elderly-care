{
  "name": "saathi-elderly-care",
  "version": "1.0.0",
  "private": true,
  "description": "Saathi \u2014 a shared care circle for elderly medication, appointment and adherence management with escalating email reminders.",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma.mjs generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:push": "node scripts/prisma.mjs db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/prisma.mjs db push --force-reset && tsx prisma/seed.ts",
    "setup": "node scripts/prisma.mjs db push && tsx prisma/seed.ts",
    "remote:setup": "node --env-file=.env.remote scripts/prisma.mjs db push && tsx --env-file=.env.remote prisma/seed.ts && node scripts/prisma.mjs generate",
    "reminders:run": "tsx scripts/run-reminders.ts",
    "postinstall": "node scripts/prisma.mjs generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "luxon": "3.7.2",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
