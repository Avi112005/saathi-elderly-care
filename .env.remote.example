# Copy to .env.remote (git-ignored) and fill in, then run:  npm run remote:setup
# Creates the tables in Supabase and loads the demo circle. Never commit real values.

# Supabase → Connect → "Transaction pooler" (port 6543)
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=saathi"
# Supabase → Connect → "Session pooler" (port 5432)
DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?schema=saathi"

# Optional: choose the demo PINs (otherwise random ones are printed once)
DEMO_ELDER_PIN=""
DEMO_CARETAKER_PIN=""
DEMO_FAMILY_PIN=""
